{
  "name": "ai-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Versioned golden evaluation datasets and deterministic scoring for VELARIS agents (F-08, AC-F08-1/2). Synthetic data only.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
