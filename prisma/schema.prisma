// VELARIS identity and tenancy schema (task T1.01).
//
// Proposed baseline per docs/DATABASE.md sections 2-3 (entities E-enterprise,
// E-tenant, E-user, E-membership). Table and column names follow the documented
// snake_case baseline via @@map/@map. ID columns use UUIDs per DATABASE.md
// section 3. Status enum values are proposed defaults and need owner
// confirmation before production use. Unique constraints follow
// DATABASE.md section 3 exactly: slug global uniqueness and user email
// uniqueness are open product questions and are NOT constrained here yet.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs for Migrate live in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

enum EnterpriseOrganizationStatus {
  ACTIVE
  INACTIVE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum TenantMembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REVOKED
}

/// E-enterprise: platform-level grouping for multiple tenants.
model EnterpriseOrganization {
  id        String                       @id @default(uuid()) @db.Uuid
  name      String
  status    EnterpriseOrganizationStatus @default(ACTIVE)
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("enterprise_organizations")
}

/// E-tenant: company/workspace and the primary data-isolation boundary.
model Tenant {
  id                       String       @id @default(uuid()) @db.Uuid
  enterpriseOrganizationId String       @map("enterprise_organization_id") @db.Uuid
  name                     String
  slug                     String
  status                   TenantStatus @default(ACTIVE)
  version                  Int          @default(0)
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  enterpriseOrganization EnterpriseOrganization @relation(fields: [enterpriseOrganizationId], references: [id])
  memberships            TenantMembership[]
  roles                  Role[]
  auditEvents            AuditEvent[]
  customers              Customer[]
  conversations          Conversation[]
  messages               Message[]
  tickets                Ticket[]
  knowledgeSources       KnowledgeSource[]
  aiAgents               AiAgent[]
  agentVersions          AiAgentVersion[]
  agentToolGrants        AgentToolGrant[]
  evaluationRuns         EvaluationRun[]
  toolDefinitions        AiToolDefinition[]
  toolApprovals          ToolApprovalRequest[]

  @@unique([slug])
  @@map("tenants")
}

/// E-user: human identity as resolved by the identity provider (D-03: Supabase Auth).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  provider        String     @default("supabase")
  externalSubject String     @map("external_subject")
  emailNormalized String     @map("email_normalized")
  displayName     String     @map("display_name")
  /** Small browser-compressed image; empty string records removal. */
  avatarDataUrl   String?    @map("avatar_data_url") @db.Text
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  memberships TenantMembership[]

  // External subject is unique per identity provider (DATABASE.md section 3).
  @@unique([provider, externalSubject])
  @@map("users")
}

/// E-membership: user-to-tenant relationship; tenant context resolution reads this.
model TenantMembership {
  id        String                 @id @default(uuid()) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  status    TenantMembershipStatus @default(ACTIVE)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  user   User             @relation(fields: [userId], references: [id])
  roles  MembershipRole[]
  ownedAgents AiAgent[]

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@map("tenant_memberships")
}

/// E-role: named permission bundle. tenant_id NULL marks a system role
/// (DATABASE.md section 5). System-role code uniqueness cannot be a
/// partial unique index in Prisma, so the seed and the application layer
/// keep system codes unique; the composite unique covers tenant roles.
model Role {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  code          String
  name          String
  systemManaged Boolean  @default(true) @map("system_managed")
  /** Canonical permission profile inherited by a tenant custom role. */
  baseRoleCode  String?  @map("base_role_code")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  memberships MembershipRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// E-role assignment: which membership holds which role.
/// Scope rule (validated in the resolver): the role is either a system
/// role (tenant_id NULL) or belongs to the membership's tenant.
model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

/// E-audit-event: append-oriented security/admin action history
/// (DATABASE.md section 5). No update or delete path exists in Prisma;
/// retention and restricted querying arrive with the audit query task.
/// actor_id stores the identity provider subject and carries no FK, so
/// audit rows survive local user changes.
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadataJson Json?    @map("metadata_json")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@map("audit_events")
}

/// E-revoked-token: a signed-out access token (and its Supabase session) that
/// must be refused before the verifier cache expires. The row stores only a
/// SHA-256 digest of the token, never the bearer credential. Rows are kept
/// until `expires_at`, so an expired JWT is not retained indefinitely.
model RevokedAccessToken {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  sessionId String?  @map("session_id") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime @default(now()) @map("revoked_at")

  @@index([sessionId])
  @@index([expiresAt])
  @@map("revoked_access_tokens")
}

// ---- Phase 2: core support vertical slice (T2.01) ----
// Proposed baseline per docs/DATABASE.md section 6 (E-customer,
// E-conversation, E-message, E-ticket). Enum values are proposed defaults
// and need owner confirmation before production use (AC-F05-2 depends on
// the ticket status set). Tenant isolation is the primary boundary; every
// model carries tenant_id or an enforceable path to it.

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

/// Author of a message. `customer` and `agent` are tenant-scoped humans;
/// `system` covers automated/worker-authored messages.
enum MessageAuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}

/// Visibility boundary (F-05, TH-05). INTERNAL notes never serialize to a
/// customer-facing response; that rule is enforced in the API layer and
/// covered by tests, not by this enum alone.
enum MessageVisibility {
  CUSTOMER_VISIBLE
  INTERNAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SlaState {
  NOT_SET
  WITHIN_TARGET
  AT_RISK
  BREACHED
}

/// E-customer: end customer profile within one tenant (DATABASE.md 6).
/// Soft delete via deleted_at; metadata_json must not store secrets.
model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  externalRef  String?        @map("external_ref")
  displayName  String         @map("display_name")
  email        String?
  phone        String?
  status       CustomerStatus @default(ACTIVE)
  metadataJson Json?          @map("metadata_json")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]
  tickets       Ticket[]

  @@index([tenantId, email])
  @@index([tenantId, externalRef])
  @@map("customers")
}

/// E-conversation: communication history for one customer in one tenant.
/// version supports optimistic concurrency on status/metadata updates.
model Conversation {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  customerId String             @map("customer_id") @db.Uuid
  channel    String
  status     ConversationStatus @default(OPEN)
  version    Int                @default(0)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  messages Message[]
  tickets  Ticket[]

  @@index([tenantId, updatedAt(sort: Desc)])
  @@index([tenantId, customerId])
  @@map("conversations")
}

/// E-message: customer-visible message or internal note (DATABASE.md 6).
/// visibility distinguishes the two. No updatedAt: messages are immutable
/// records; there is no update path in Prisma for this model.
model Message {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  authorType     MessageAuthorType @map("author_type")
  authorId       String?           @map("author_id") @db.Uuid
  visibility     MessageVisibility
  body           String
  metadataJson   Json?             @map("metadata_json")
  idempotencyKey String?           @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])

  // Unique per conversation where an idempotency key is supplied, so a
  // retried write cannot duplicate a message.
  @@unique([conversationId, idempotencyKey])
  @@index([tenantId, conversationId, createdAt])
  @@map("messages")
}

/// E-ticket: operational support work item (DATABASE.md 6).
/// version implements optimistic concurrency (AC-F05-2): an update carrying
/// a stale version is rejected with a conflict. resolved_at/closed_at are
/// nullable lifecycle timestamps.
model Ticket {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  customerId            String         @map("customer_id") @db.Uuid
  primaryConversationId String?        @map("primary_conversation_id") @db.Uuid
  title                 String
  status                TicketStatus   @default(OPEN)
  priority              TicketPriority @default(MEDIUM)
  slaState              SlaState       @default(NOT_SET) @map("sla_state")
  assigneeMembershipId  String?        @map("assignee_membership_id") @db.Uuid
  tags                  String[]
  version               Int            @default(0)
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  resolvedAt            DateTime?      @map("resolved_at")
  closedAt              DateTime?      @map("closed_at")

  tenant              Tenant        @relation(fields: [tenantId], references: [id])
  customer            Customer      @relation(fields: [customerId], references: [id])
  primaryConversation Conversation? @relation(fields: [primaryConversationId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, assigneeMembershipId, status])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@map("tickets")
}

/// Ingestion state for a knowledge source (AC-F07-1 happy path and
/// AC-F07-2 failure/retry reporting).
enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Accepted knowledge source types (F-07: website, PDF, Markdown, FAQ,
/// manual articles and explicitly enabled historical support information).
enum KnowledgeSourceType {
  WEBSITE
  PDF
  MARKDOWN
  FAQ
  MANUAL
  HISTORY
}

/// E-knowledge-source: source metadata, ingestion status and provenance
/// (DATABASE.md 6). Unique (tenant, type, content hash) makes
/// re-ingestion of identical content idempotent. deleted_at supports the
/// F-14 deletion lifecycle without losing audit references.
model KnowledgeSource {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  sourceType     KnowledgeSourceType   @map("source_type")
  sourceUri      String?               @map("source_uri")
  objectKey      String?               @map("object_key")
  status         KnowledgeSourceStatus @default(PENDING)
  contentHash    String                @map("content_hash")
  provenanceJson Json                  @default("{}") @map("provenance_json")
  errorCode      String?               @map("error_code")
  createdBy      String                @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")
  /// T5.02 retention window chosen at ingest time; null means no expiry.
  retentionDays Int?                   @map("retention_days")
  /// Instant after which the source and its chunks must not be retrievable.
  expiresAt     DateTime?              @map("expires_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  chunks KnowledgeChunk[]

  @@unique([tenantId, sourceType, contentHash])
  @@index([tenantId, status])
  @@index([tenantId, expiresAt])
  @@map("knowledge_sources")
}

/// E-knowledge-chunk: parsed chunk with metadata (DATABASE.md 6). Unique
/// (source, chunk_index) makes re-indexing replace chunks instead of
/// duplicating them. Deletion cascades from the source (F-14 cleanup).
model KnowledgeChunk {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sourceId     String   @map("source_id") @db.Uuid
  chunkIndex   Int      @map("chunk_index")
  content      String
  metadataJson Json     @default("{}") @map("metadata_json")
  tokenCount   Int      @map("token_count")
  createdAt    DateTime @default(now()) @map("created_at")

  source     KnowledgeSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  embeddings KnowledgeEmbedding[]

  @@unique([sourceId, chunkIndex])
  @@index([tenantId, sourceId, createdAt])
  @@map("knowledge_chunks")
}

/// E-embedding: pgvector representation linked to chunk and model
/// (DATABASE.md 6). Unique (chunk, model) allows one vector per model
/// version; a CHECK keeps dimensions positive; the pgvector index strategy
/// stays deferred until T3.04 retrieval benchmarks (DATABASE.md 6).
/// The vector value is written through SQL (Unsupported type), which
/// T3.03's ingestion pipeline does.
model KnowledgeEmbedding {
  id         String                      @id @default(uuid()) @db.Uuid
  tenantId   String                      @map("tenant_id") @db.Uuid
  chunkId    String                      @map("chunk_id") @db.Uuid
  embedding  Unsupported("vector(1536)")
  model      String                      @db.VarChar(64)
  dimensions Int
  createdAt  DateTime                    @default(now()) @map("created_at")

  chunk KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, model])
  @@index([tenantId])
  @@map("knowledge_embeddings")
}

/// Retention categories a tenant can configure (T5.02, AC-F14-2).
enum RetentionCategory {
  KNOWLEDGE
  TRACES
  MEMORY
}

/// E-ai-trace: AI run metadata, outcome and correlation (DATABASE.md 6).
/// No message content and no credentials; the correlation id links the run to
/// the request, audit rows and logs (T5.01). `expires_at` bounds retention.
model AiTrace {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  correlationId     String   @map("correlation_id")
  agentId           String?  @map("agent_id") @db.Uuid
  agentVersionId    String?  @map("agent_version_id") @db.Uuid
  provider          String
  model             String?
  outcome           String
  latencyMs         Int      @map("latency_ms")
  usageJson         Json     @default("{}") @map("usage_json")
  spansMetadataJson Json     @default("{}") @map("spans_metadata_json")
  createdAt         DateTime @default(now()) @map("created_at")
  expiresAt         DateTime @map("expires_at")

  @@index([correlationId])
  @@index([tenantId, createdAt])
  @@index([expiresAt])
  @@map("ai_traces")
}

/// E-memory: opt-in scoped memory with provenance and expiry (DATABASE.md 6).
/// A row with a past `expires_at` or a set `deleted_at` is never retrievable.
model AiMemory {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  customerId          String?   @map("customer_id") @db.Uuid
  scope               String
  content             String
  provenanceJson      Json      @default("{}") @map("provenance_json")
  confidence          Float
  permissionScopeJson Json      @default("{}") @map("permission_scope_json")
  createdAt           DateTime  @default(now()) @map("created_at")
  expiresAt           DateTime  @map("expires_at")
  deletedAt           DateTime? @map("deleted_at")

  @@index([tenantId, expiresAt])
  @@map("ai_memories")
}

/// Tenant retention configuration per category (T5.02, AC-F14-2).
/// Bounds are enforced by the API contract and a database CHECK.
model RetentionPolicy {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  category      RetentionCategory
  retentionDays Int               @map("retention_days")
  updatedBy     String?           @map("updated_by") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, category])
  @@map("retention_policies")
}

enum AgentStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AgentVersionStatus {
  DRAFT
  PUBLISHED
}

/// F-10 risk tiers. HIGH and CRITICAL always need a human decision, even
/// when the definition forgot `approvalRequired` (tool-execution enforces
/// the floor in code; the column alone is not trusted).
enum ToolRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ToolApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum EvaluationRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
}

/// E-agent: agent identity and tenant-scoped configuration (DATABASE.md 6,
/// F-08). ownerMembershipId names the accountable tenant member; the row
/// is deleted only when its owner or tenant is, so the pointer uses the
/// default RESTRICT rather than a silent orphan.
model AiAgent {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  name              String
  description       String      @default("")
  status            AgentStatus @default(DRAFT)
  ownerMembershipId String      @map("owner_membership_id") @db.Uuid
  activeVersionId   String?     @map("active_version_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  ownerMember   TenantMembership      @relation(fields: [ownerMembershipId], references: [id])
  activeVersion AiAgentVersion?       @relation("AgentActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions      AiAgentVersion[]      @relation("AgentVersions")

  @@index([tenantId, name])
  @@map("ai_agents")
}

/// E-agent-version: immutable configuration snapshot (DATABASE.md 6,
/// AC-F08-1). Unique (agent, version) orders snapshots; published rows
/// are immutable in the database itself (BEFORE UPDATE trigger in
/// migration 0005) so the audit ground truth cannot be rewritten.
/// No updatedAt column: an immutable row has no meaningful update time.
model AiAgentVersion {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  agentId     String              @map("agent_id") @db.Uuid
  version     Int
  configJson  Json                @map("config_json")
  createdBy   String              @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  publishedAt DateTime?           @map("published_at")
  status      AgentVersionStatus  @default(DRAFT)

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  agent          AiAgent           @relation("AgentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  activeFor      AiAgent[]             @relation("AgentActiveVersion")
  toolGrants     AgentToolGrant[]
  evaluationRuns EvaluationRun[]
  toolApprovals  ToolApprovalRequest[]

  @@unique([agentId, version])
  @@index([tenantId, agentId])
  @@map("ai_agent_versions")
}

/// E-tool: registered tool with schema, risk and approval metadata
/// (DATABASE.md 6, F-10). A NULL tenant_id is a platform tool available to
/// every tenant; a set tenant_id keeps the definition tenant-owned. The
/// model never invents a tool: only a row here can be proposed, and
/// tool-execution rechecks permission, grant, schema and approval at run
/// time (T4.04). `timeout_ms` is bounded by a CHECK constraint added in the
/// migration so a bad row cannot disable the execution deadline.
model AiToolDefinition {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String?       @map("tenant_id") @db.Uuid
  name               String        @db.VarChar(128)
  description        String?
  inputSchemaJson    Json          @map("input_schema_json")
  outputSchemaJson   Json?         @map("output_schema_json")
  requiredPermission String        @map("required_permission") @db.VarChar(64)
  riskLevel          ToolRiskLevel @default(MEDIUM) @map("risk_level")
  approvalRequired   Boolean       @default(false) @map("approval_required")
  timeoutMs          Int           @default(10000) @map("timeout_ms")
  retryPolicyJson    Json          @default("{}") @map("retry_policy_json")
  enabled            Boolean       @default(true)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  tenant    Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grants    AgentToolGrant[]
  approvals ToolApprovalRequest[]

  @@unique([tenantId, name])
  @@index([name])
  @@map("ai_tool_definitions")
}

/// E-tool-approval: one human decision per consequential tool proposal
/// (F-10, AC-F10-2). A proposal that needs approval never executes while
/// the row is PENDING, REJECTED or EXPIRED; only an APPROVED row that has
/// not expired lets the same proposal run, and it runs at most once
/// (consumed_at). proposal_hash binds the decision to the exact arguments.
model ToolApprovalRequest {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  toolDefinitionId String             @map("tool_definition_id") @db.Uuid
  agentVersionId   String             @map("agent_version_id") @db.Uuid
  proposalHash     String             @map("proposal_hash") @db.VarChar(64)
  proposalJson     Json               @map("proposal_json")
  requestedBy      String             @map("requested_by") @db.Uuid
  status           ToolApprovalStatus @default(PENDING)
  decidedBy        String?            @map("decided_by") @db.Uuid
  decidedAt        DateTime?          @map("decided_at")
  expiresAt        DateTime           @map("expires_at")
  consumedAt       DateTime?          @map("consumed_at")
  createdAt        DateTime           @default(now()) @map("created_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tool         AiToolDefinition @relation(fields: [toolDefinitionId], references: [id], onDelete: Cascade)
  agentVersion AiAgentVersion  @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, toolDefinitionId, proposalHash, status])
  @@map("tool_approval_requests")
}

/// E-agent-tool-grant: explicit agent-to-tool capability grant
/// (DATABASE.md 6, F-10). Unique (version, tool) so a capability cannot
/// be granted twice; execution rechecks current authorization at run time
/// (T4.04). tool_id references ai_tool_definitions, so a grant cannot name
/// a tool that does not exist.
model AgentToolGrant {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  agentVersionId String   @map("agent_version_id") @db.Uuid
  toolId         String   @map("tool_id") @db.Uuid
  grantedBy      String   @map("granted_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  agentVersion AiAgentVersion   @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  tool         AiToolDefinition @relation(fields: [toolId], references: [id], onDelete: Restrict)

  @@unique([agentVersionId, toolId])
  @@index([tenantId])
  @@index([toolId])
  @@map("agent_tool_grants")
}

/// E-evaluation-run: dataset/agent-version result summary (DATABASE.md 6,
/// F-08). AC-F08-2 reads failureReasonsJson to block publication with
/// actionable findings; aggregateJson holds the score summary.
model EvaluationRun {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  agentVersionId     String              @map("agent_version_id") @db.Uuid
  datasetVersion     String              @map("dataset_version")
  provider           String              @db.VarChar(64)
  model              String              @db.VarChar(64)
  status             EvaluationRunStatus @default(PENDING)
  aggregateJson      Json                @default("{}") @map("aggregate_json")
  failureReasonsJson Json                @default("[]") @map("failure_reasons_json")
  createdAt          DateTime            @default(now()) @map("created_at")
  completedAt        DateTime?           @map("completed_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  agentVersion AiAgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentVersionId])
  @@map("evaluation_runs")
}

/// E-integration-endpoint: one registered inbound webhook for a tenant
/// (T5.05; F-13; API-16). `secret_ref` names an environment variable; the
/// signing secret itself never enters the database (D-30).
model IntegrationEndpoint {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  provider    String                    @db.VarChar(40)
  displayName String                    @map("display_name")
  secretRef   String                    @map("secret_ref") @db.VarChar(64)
  status      IntegrationEndpointStatus @default(ACTIVE)
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  @@unique([tenantId, provider, displayName])
  @@index([tenantId, createdAt])
  @@map("integration_endpoints")
}

/// E-webhook-delivery: idempotency record for one provider delivery
/// (T5.05; TH-08). The unique pair makes a retried delivery one side effect;
/// `payload_hash` makes a reused id with another body a 409.
model WebhookDelivery {
  id          String                @id @default(uuid()) @db.Uuid
  endpointId  String                @map("endpoint_id") @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  provider    String                @db.VarChar(40)
  deliveryId  String                @map("delivery_id") @db.VarChar(128)
  payloadHash String                @map("payload_hash") @db.VarChar(64)
  status      WebhookDeliveryStatus @default(PROCESSED)
  receivedAt  DateTime              @default(now()) @map("received_at")

  @@unique([endpointId, deliveryId])
  @@index([tenantId, receivedAt])
  @@map("webhook_deliveries")
}

enum IntegrationEndpointStatus {
  ACTIVE
  PAUSED
}

enum WebhookDeliveryStatus {
  PROCESSED
  FAILED
}
