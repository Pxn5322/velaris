// VELARIS identity and tenancy schema (task T1.01).
//
// Proposed baseline per docs/DATABASE.md sections 2-3 (entities E-enterprise,
// E-tenant, E-user, E-membership). Table and column names follow the documented
// snake_case baseline via @@map/@map. ID columns use UUIDs per DATABASE.md
// section 3. Status enum values are proposed defaults and need owner
// confirmation before production use. Unique constraints follow
// DATABASE.md section 3 exactly: slug global uniqueness and user email
// uniqueness are open product questions and are NOT constrained here yet.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs for Migrate live in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

enum EnterpriseOrganizationStatus {
  ACTIVE
  INACTIVE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum TenantMembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REVOKED
}

/// E-enterprise: platform-level grouping for multiple tenants.
model EnterpriseOrganization {
  id        String                       @id @default(uuid()) @db.Uuid
  name      String
  status    EnterpriseOrganizationStatus @default(ACTIVE)
  createdAt DateTime                     @default(now()) @map("created_at")
  updatedAt DateTime                     @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("enterprise_organizations")
}

/// E-tenant: company/workspace and the primary data-isolation boundary.
model Tenant {
  id                       String       @id @default(uuid()) @db.Uuid
  enterpriseOrganizationId String       @map("enterprise_organization_id") @db.Uuid
  name                     String
  slug                     String
  status                   TenantStatus @default(ACTIVE)
  version                  Int          @default(0)
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  enterpriseOrganization EnterpriseOrganization @relation(fields: [enterpriseOrganizationId], references: [id])
  memberships            TenantMembership[]
  roles                  Role[]
  auditEvents            AuditEvent[]

  @@unique([slug])
  @@map("tenants")
}

/// E-user: human identity as resolved by the identity provider (D-03: Supabase Auth).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  provider        String     @default("supabase")
  externalSubject String     @map("external_subject")
  emailNormalized String     @map("email_normalized")
  displayName     String     @map("display_name")
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  memberships TenantMembership[]

  // External subject is unique per identity provider (DATABASE.md section 3).
  @@unique([provider, externalSubject])
  @@map("users")
}

/// E-membership: user-to-tenant relationship; tenant context resolution reads this.
model TenantMembership {
  id        String                 @id @default(uuid()) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  status    TenantMembershipStatus @default(ACTIVE)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  user   User             @relation(fields: [userId], references: [id])
  roles  MembershipRole[]

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@map("tenant_memberships")
}

/// E-role: named permission bundle. tenant_id NULL marks a system role
/// (DATABASE.md section 5). System-role code uniqueness cannot be a
/// partial unique index in Prisma, so the seed and the application layer
/// keep system codes unique; the composite unique covers tenant roles.
model Role {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  code          String
  name          String
  systemManaged Boolean  @default(true) @map("system_managed")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id])
  memberships MembershipRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// E-role assignment: which membership holds which role.
/// Scope rule (validated in the resolver): the role is either a system
/// role (tenant_id NULL) or belongs to the membership's tenant.
model MembershipRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
  @@map("membership_roles")
}

/// E-audit-event: append-oriented security/admin action history
/// (DATABASE.md section 5). No update or delete path exists in Prisma;
/// retention and restricted querying arrive with the audit query task.
/// actor_id stores the identity provider subject and carries no FK, so
/// audit rows survive local user changes.
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadataJson Json?    @map("metadata_json")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@map("audit_events")
}
